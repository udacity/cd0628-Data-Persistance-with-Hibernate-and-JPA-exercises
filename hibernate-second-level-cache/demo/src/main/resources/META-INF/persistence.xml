<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="demoPU" transaction-type="RESOURCE_LOCAL">
        <class>com.example.demo.Country</class>

        <!-- Only cache entities we've explicitly marked with @Cacheable -->
        <shared-cache-mode>ENABLE_SELECTIVE</shared-cache-mode>

        <properties>
            <property name="jakarta.persistence.jdbc.driver"   value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url"      value="jdbc:postgresql://localhost:5432/banking"/>
            <property name="jakarta.persistence.jdbc.user"     value="banking"/>
            <property name="jakarta.persistence.jdbc.password" value="banking"/>

            <property name="hibernate.hbm2ddl.auto"     value="create-drop"/>
            <property name="hibernate.show_sql"         value="true"/>
            <property name="hibernate.format_sql"       value="true"/>

            <!-- Second-level cache configuration.
                 The JCache region factory routes cache calls to a JSR-107 provider.
                 cache2k is registered as our JCache provider on the classpath. -->
            <property name="hibernate.cache.use_second_level_cache"  value="true"/>
            <property name="hibernate.cache.region.factory_class"    value="jcache"/>
            <property name="hibernate.javax.cache.provider"          value="org.cache2k.jcache.provider.JCacheProvider"/>
            <property name="hibernate.javax.cache.missing_cache_strategy" value="create"/>

            <!-- Optional: also cache the results of queries that ask for it -->
            <property name="hibernate.cache.use_query_cache"         value="true"/>
        </properties>
    </persistence-unit>
</persistence>
